# TZ-108: both Dockerfile (dev) and Dockerfile.prod do `RUN npm install`/
# `npm ci` themselves, then `COPY . .` — without excluding node_modules here,
# that COPY overwrites the container's own just-installed node_modules with
# whatever is on the host (Windows-installed, platform-specific native
# bindings for esbuild/rollup among others), which is exactly the kind of
# thing that breaks a build non-deterministically depending on what's sitting
# on the host at build time. dist/ is regenerated by `npm run build` in the
# same stage, so shipping the stale local copy into the context is pure waste.

.git
node_modules/
dist/

.pytest_cache/
playwright-report/
test-results/
tests/
design-reference/

# VITE_API_URL is empty here and falls back to "" (relative /api, proxied by
# nginx) when unset — see frontend/src/utils/api.ts — so excluding this from
# the build context changes nothing functionally.
.env
.env.*

*.md
